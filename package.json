{
  "name": "accounts-sdk",
  "version": "1.0.0",
  "description": "PineWarp's mod of rotur-sdk",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
